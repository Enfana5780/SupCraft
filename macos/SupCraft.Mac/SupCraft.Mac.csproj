<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SupCraft</AssemblyName>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../VERSION').Trim())</Version>
    <Product>SupCraft</Product>
    <ApplicationIcon>../../assets/subforge.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="../SupCraft.Core/SupCraft.Core.csproj" />
    <EmbeddedResource Include="../../assets/subforge.png" LogicalName="SupCraft.Icon.png" />
  </ItemGroup>
</Project>
